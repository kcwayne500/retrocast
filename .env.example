# COPY THIS FILE TO .env FOR LOCAL OVERRIDES.
# RF is disabled by default. Only enable after arranging a lawful,
# properly attenuated and DC-isolated RF bench connection to your TV.
RETROCAST_RF_ENABLED=0
RETROCAST_HOST=127.0.0.1
RETROCAST_PORT=8765
RETROCAST_HACKTV_BIN=hacktv
RETROCAST_MEDIA_DIR=media
RETROCAST_MAX_UPLOAD_MB=1024
